{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/tsnode",
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "scripts/**/*.mjs"]
}
