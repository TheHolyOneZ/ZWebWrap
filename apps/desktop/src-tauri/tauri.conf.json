{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZWebWrap",
  "version": "0.1.0",
  "identifier": "dev.zwebwrap.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run vite:dev",
    "beforeBuildCommand": "pnpm run vite:build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Turn any webpage into a minimal desktop app",
    "longDescription": "ZWebWrap turns a webpage into a real desktop app: a shortcut that opens the site in a small, fast, single-purpose window with ad blocking. It is not a browser - no tabs, no address bar, and each window is locked to one site.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ]
      }
    },
    "publisher": "ZWebWrap",
    "homepage": "https://github.com/theholyonez/ZWebWrap",
    "licenseFile": "../../../LICENSE"
  },
  "plugins": {}
}
