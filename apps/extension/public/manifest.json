{
  "manifest_version": 3,
  "name": "ZWebWrap",
  "version": "0.2.0",
  "description": "Turn the page you are on into a minimal desktop app. Requires the ZWebWrap desktop app.",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Create a desktop app from this page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zwebwrap@zlogic.eu",
      "strict_min_version": "128.0"
    }
  }
}
